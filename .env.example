# Copy to .env for local overrides. Never commit .env.
# All values have safe defaults; the static site runs with zero secrets.

# HTTP port for `npm start`
PORT=4173

# Bind address (default loopback)
HOST=127.0.0.1

# debug | info | warn | error
LOG_LEVEL=info

# WEEK-004 local API: mock (fixture, default) | off (404, UI shows error)
WEEK_API=mock

# 1 = require Origin/Referer in allowlist (closer to production)
WEEK_API_STRICT_ORIGIN=0

# Comma-separated origins allowed to POST /api/week
ALLOW_ORIGIN=http://127.0.0.1:4173,http://localhost:4173,https://build-100.com
